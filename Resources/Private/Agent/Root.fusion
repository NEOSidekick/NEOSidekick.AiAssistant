include: resource://Neos.Fusion/Private/Fusion/Root.fusion

NEOSidekick.AiAssistant.AgentController.index = Neos.Fusion:Component {
    userName = ${userName}
    csrfToken = ${csrfToken}
    authorizeActionUri = ${authorizeActionUri}
    state = ${state}
    isExternalConsent = ${isExternalConsent}
    consumer = ${consumer}
    # A client without a name (or one the sanitizer emptied) must not render as an empty pair of quotes
    clientName = ${clientName != '' ? clientName : I18n.translate('NEOSidekick.AiAssistant:Agent:externalClientUnnamed')}
    redirectHost = ${redirectHost}
    declineUri = ${declineUri}

    renderer = afx`
        <html>
            <head>
                <title>{I18n.translate('NEOSidekick.AiAssistant:Agent:pageTitle')}</title>
                <link rel="stylesheet" href={StaticResource.uri('NEOSidekick.AiAssistant', 'Public/Agent.css')} />
            </head>
            <body>
                <div class="auth-container" @if.isChatConsent={!props.isExternalConsent}>
                    <h1>{I18n.translate('NEOSidekick.AiAssistant:Agent:authorizationTitle')}</h1>
                    <p>{I18n.translate('NEOSidekick.AiAssistant:Agent:authorizationMessage')}</p>
                    <form method="POST" action={props.authorizeActionUri}>
                        <input type="hidden" name="__csrfToken" value={props.csrfToken} />
                        <input type="hidden" name="state" value={props.state} />
                        <button type="submit" class="auth-button">
                            {I18n.translate('NEOSidekick.AiAssistant:Agent:authorizeButton')}
                        </button>
                    </form>
                </div>
                <div class="auth-container" @if.isExternalConsent={props.isExternalConsent}>
                    <h1>{I18n.translate('NEOSidekick.AiAssistant:Agent:externalAuthorizationTitle')}</h1>
                    <p>{I18n.translate('externalClientMessage', null, [String.htmlSpecialChars(props.clientName)], 'Agent', 'NEOSidekick.AiAssistant')}</p>
                    <p>{I18n.translate('externalIdentityMessage', null, [String.htmlSpecialChars(props.userName)], 'Agent', 'NEOSidekick.AiAssistant')}</p>
                    <p>{I18n.translate('externalRedirectMessage', null, [String.htmlSpecialChars(props.redirectHost)], 'Agent', 'NEOSidekick.AiAssistant')}</p>
                    <form method="POST" action={props.authorizeActionUri}>
                        <input type="hidden" name="__csrfToken" value={props.csrfToken} />
                        <input type="hidden" name="state" value={props.state} />
                        <input type="hidden" name="consumer" value={props.consumer} />
                        <button type="submit" class="auth-button">
                            {I18n.translate('NEOSidekick.AiAssistant:Agent:externalAuthorizeButton')}
                        </button>
                    </form>
                    <p class="auth-decline">
                        <a href={props.declineUri}>{I18n.translate('NEOSidekick.AiAssistant:Agent:externalDeclineLink')}</a>
                    </p>
                </div>
            </body>
        </html>
    `
}

NEOSidekick.AiAssistant.AuthorizationRedirectController.index = Neos.Fusion:Component {
    authorizationUrl = ${authorizationUrl}

    renderer = afx`
        <html>
            <head>
                <title>{I18n.translate('NEOSidekick.AiAssistant:Agent:continueAuthorizationPageTitle')}</title>
                <link rel="stylesheet" href={StaticResource.uri('NEOSidekick.AiAssistant', 'Public/Agent.css')} />
            </head>
            <body>
                <div class="auth-container">
                    <h1>{I18n.translate('NEOSidekick.AiAssistant:Agent:continueAuthorizationTitle')}</h1>
                    <p>{I18n.translate('NEOSidekick.AiAssistant:Agent:continueAuthorizationMessage')}</p>
                    <a href={props.authorizationUrl} class="auth-button">
                        {I18n.translate('NEOSidekick.AiAssistant:Agent:continueAuthorizationButton')}
                    </a>
                </div>
            </body>
        </html>
    `
}
