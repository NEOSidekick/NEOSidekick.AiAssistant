include: resource://Neos.Fusion/Private/Fusion/Root.fusion
include: resource://Neos.Neos.Ui/Private/Fusion/Prototypes/RenderConfiguration.fusion
include: resource://Sitegeist.FusionLinkPrototypes/Private/Fusion/Root.fusion
include: ./BackendModule.fusion

NEOSidekick.AiAssistant.BackendModule.ImageAlternativeTextController.index = NEOSidekick.AiAssistant:BackendModule {
    getAction = 'findAssets'
    updateAction = 'updateAssets'
    moduleConfiguration = Neos.Fusion:Value {
        defaults = Neos.Fusion:DataStructure {
            itemType = 'Asset'
            onlyAssetsInUse = false
            propertyName = 'title'
            itemsPerPage = 10
            language = ${Configuration.setting('NEOSidekick.AiAssistant.defaultLanguage')}
            recommendNeosAssetCachePackage = ${NEOSidekickInternal.recommendNeosAssetCachePackage()}
        }
        config = ${Array.filter(Configuration.setting('NEOSidekick.AiAssistant.altTextGeneratorModule'), (value, key) => value != null)}
        enforceConfigs = ${Array.keys(Array.filter(this.config, (value, key) => key != 'itemsPerPage'))}
        editableProperties = ${this.config.propertyName ? [this.config.propertyName] : ['title']}
        value = ${Array.concat(this.defaults, this.config, {enforceConfigs: this.enforceConfigs}, {editableProperties: this.editableProperties})}
    }
}

NEOSidekick.AiAssistant.BackendModule.FocusKeywordController.index = NEOSidekick.AiAssistant:BackendModule {
    getAction = 'findDocumentNodes'
    updateAction = 'updateNodeProperties'
    moduleConfiguration = Neos.Fusion:Value {
        defaults = Neos.Fusion:DataStructure {
            // moduleName is only used for the configuration form text
            moduleName = 'FocusKeyword'
            filter = 'important-pages'
            itemType = 'DocumentNode'
            workspace = 'live'
            focusKeywordPropertyFilter = null
            focusKeywordPropertyFilterOptions = ${['none', 'only-empty-focus-keywords', 'only-existing-focus-keywords']}
            languageDimensionFilter = ${NEOSidekickInternal.languageDimensionValuesEnabledForEditing()}
            nodeTypeFilter = null
            baseNodeTypeFilter = 'NEOSidekick.AiAssistant:Mixin.AiPageBriefing'
            itemsPerPage = 10
            editableProperties = ${['focusKeyword']}
            actions = Neos.Fusion:DataStructure
        }
        config = ${Array.filter(Configuration.setting('NEOSidekick.AiAssistant.focusKeywordGeneratorModule'), (value, key) => value != null)}
        enforceConfigs = ${Array.keys(Array.filter(this.config, (value, key) => key != 'itemsPerPage'))}
        value = ${Array.concat(this.defaults, this.config, {enforceConfigs: this.enforceConfigs})}
    }
}

NEOSidekick.AiAssistant.BackendModule.SeoTitleAndMetaDescriptionController.index = NEOSidekick.AiAssistant:BackendModule {
    getAction = 'findDocumentNodes'
    updateAction = 'updateNodeProperties'
    moduleConfiguration = Neos.Fusion:Value {
        defaults = Neos.Fusion:DataStructure {
            // moduleName is only used for the configuration form text
            moduleName = 'SeoTitleAndMetaDescription'
            filter = 'important-pages'
            itemType = 'DocumentNode'
            workspace = 'live'
            seoPropertiesFilter = null
            seoPropertiesFilterOptions = ${['none', 'only-empty-seo-titles-or-meta-descriptions', 'only-empty-seo-titles', 'only-empty-meta-descriptions', 'only-existing-seo-titles', 'only-existing-meta-descriptions']}
            focusKeywordPropertyFilter = null
            focusKeywordPropertyFilterOptions = ${['none', 'only-empty-focus-keywords', 'only-existing-focus-keywords']}
            languageDimensionFilter = ${NEOSidekickInternal.languageDimensionValues()}
            nodeTypeFilter = null
            baseNodeTypeFilter = 'Neos.Seo:SeoMetaTagsMixin'
            itemsPerPage = 10
            readonlyProperties = ${['focusKeyword']}
            editableProperties = ${['titleOverride', 'metaDescription']}
            showSeoDirectives = true
            actions = Neos.Fusion:DataStructure {
                'autoGenerateEmptySeoTitles' = ${{'active': true, 'propertyName': 'titleOverride', 'clientEval': 'ClientEval: !node.properties.titleOverride'}}
                'autoGenerateEmptyMetaDescriptions' = ${{'active': true, 'propertyName': 'metaDescription', 'clientEval': 'ClientEval: !node.properties.metaDescription'}}
                'autoGenerateExistingSeoTitles' = ${{'active': false, 'propertyName': 'titleOverride', 'clientEval': 'ClientEval: node.properties.titleOverride'}}
                'autoGenerateExistingMetaDescriptions' = ${{'active': false, 'propertyName': 'metaDescription', 'clientEval': 'ClientEval: node.properties.metaDescription'}}
            }
        }
        config = ${Array.filter(Configuration.setting('NEOSidekick.AiAssistant.seoTitleAndMetaDescriptionModule'), (value, key) => value != null)}
        enforceConfigs = ${Array.keys(Array.filter(this.config, (value, key) => key != 'itemsPerPage'))}
        value = ${Array.concat(this.defaults, this.config, {enforceConfigs: this.enforceConfigs})}
    }
}

NEOSidekick.AiAssistant.BackendModule.SeoImageAlternativeTextController.index = NEOSidekick.AiAssistant:BackendModule {
    getAction = 'findDocumentNodesWithImages'
    updateAction = 'updateNodeProperties'
    moduleConfiguration = Neos.Fusion:Value {
        defaults = Neos.Fusion:DataStructure {
            // moduleName is only used for the configuration form text
            moduleName = 'SeoImageAlternativeText'
            filter = 'important-pages'
            itemType = 'DocumentNode'
            workspace = 'live'
            imagePropertiesFilter = null
            imagePropertiesFilterOptions = ${['none', 'only-empty-alternative-text-or-title-text', 'only-empty-alternative-text', 'only-existing-alternative-text', 'only-empty-title-text', 'only-existing-title-text']}
            languageDimensionFilter = ${NEOSidekickInternal.languageDimensionValues()}
            nodeTypeFilter = null
            baseNodeTypeFilter = 'Neos.Neos:Document'
            itemsPerPage = 10
            readonlyProperties = ${[]}
            editableProperties = ${[]}
            actions = Neos.Fusion:DataStructure {
                'autoGenerateEmptyAlternativeTexts' = ${{'active': true, 'propertyName': 'alternativeText', 'clientEval': 'ClientEval: !property.currentValue'}}
                'autoGenerateEmptyTitleTexts' = ${{'active': true, 'propertyName': 'titleText', 'clientEval': 'ClientEval: !property.currentValue'}}
                'autoGenerateExistingAlternativeTexts' = ${{'active': false, 'propertyName': 'alternativeText', 'clientEval': 'ClientEval: property.currentValue'}}
                'autoGenerateExistingTitleTexts' = ${{'active': false, 'propertyName': 'titleText', 'clientEval': 'ClientEval: property.currentValue'}}
            }
        }
        config = ${Array.filter(Configuration.setting('NEOSidekick.AiAssistant.seoImageAltTextGenerator'), (value, key) => value != null)}
        enforceConfigs = ${Array.keys(Array.filter(this.config, (value, key) => key != 'itemsPerPage'))}
        value = ${Array.concat(this.defaults, this.config, {enforceConfigs: this.enforceConfigs})}
    }
}

NEOSidekick.AiAssistant.BackendModule.ConfigurationController.index = Neos.Fusion:Component {
    apiDomain = ${apiDomain}
    siteDomain = ${siteDomain}
    signingKey = ${signingKey}
    embedToken = ${embedToken}
    isAdministrator = ${isAdministrator}
    regenerateActionUri = ${regenerateActionUri}
    csrfToken = ${csrfToken}
    regenerateFailure = ${regenerateFailure}
    regenerateRejectionReason = ${regenerateRejectionReason}
    renderer = afx`
        <div @if={props.apiDomain != 'https://api.neosidekick.com'} style="font-size: 1.5em; font-weight: bold; background: orange; padding: 1rem; margin-bottom: 1rem;">You are using a non-production API: {props.apiDomain}</div>
        <iframe style="width: 100%; min-height: 1000px; height: 100%; background: #3f3f3f;" src={props.apiDomain + '/chat/account-context/edit?apikey=' + apiKey + '&stay-in-settings=true' + (props.siteDomain ? '&domain=' + props.siteDomain : '') + (props.embedToken ? '&embedToken=' + String.rawUrlEncode(props.embedToken) : '')}></iframe>
        <NEOSidekick.AiAssistant:BackendModule.SigningKeyPanel @if={props.isAdministrator} signingKey={props.signingKey} regenerateActionUri={props.regenerateActionUri} csrfToken={props.csrfToken} regenerateFailure={props.regenerateFailure} regenerateRejectionReason={props.regenerateRejectionReason} />
    `
}

##
# The administrator's view of this installation's agent signing key: fingerprint, the status
# NEOSidekick last reported, and the "Regenerate key" action. Rendered for administrators
# only (see ConfigurationController::indexAction()); the action itself is guarded by the
# NEOSidekick.AiAssistant:ManageSigningKey privilege.
#
# One banner per event: while a pending pair exists only the "regeneration incomplete" banner
# renders (carrying the last answer's reason), otherwise a failed attempt renders the failure
# box. The pending banner is driven by the pending pair on disk, so a crash between
# NEOSidekick's confirmation and the local promotion still prompts a second press. Both render
# even when the live key is missing or unreadable.
#
# Opening the panel transmits the key with this installation's host set (the controller's forced
# push); the host line below is rendered from that answer alone: the address NEOSidekick calls
# this installation at, the hosts it accepts for it, whether this host is one of them, and what
# it did with the pushed set. Without an answer - the push was skipped or failed, or an older
# NEOSidekick echoed no hosts - every part reads "unknown" and neither answer below is offered.
#
# Two forms, both POSTing to the same action (Policy.yaml grants ManageSigningKey on that one
# method): "Regenerate key", with the re-enrolment checkbox for a copy of another installation,
# and "Re-register under the new domain" for a site that moved. Regenerating works from any
# host; the second form and the checkbox appear only where this host is not one NEOSidekick
# accepts for this installation, or where NEOSidekick just refused a chained rotation with
# `chain_domain_mismatch` - and never on an unusable key, which cannot chain the relabel in the
# first place. Each form carries its own static `data-confirm`, so no JavaScript decides which
# warning is shown.
#
prototype(NEOSidekick.AiAssistant:BackendModule.SigningKeyPanel) < prototype(Neos.Fusion:Component) {
    signingKey = null
    regenerateActionUri = ''
    csrfToken = ''
    regenerateFailure = null
    regenerateRejectionReason = null

    renderer = afx`
        <div style="margin-top: 2rem; padding: 1rem; background: #3f3f3f;" data-signing-key-panel="true">
            <h2 style="margin-top: 0;">{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.headline')}</h2>
            <p @if={props.signingKey.exists}>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.instruction')}</p>
            <div @if={props.regenerateFailure && !props.signingKey.regenerateIncomplete} style="margin: 0 0 1rem 0; padding: 0.75rem 1rem; border: 1px solid #ff460d; background: #2a2a2a;" data-signing-key-regenerate-failed="true">
                <strong>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerateFailed.title')}</strong>
                {' '}
                {I18n.translate('signingKey.regenerateFailed.body', null, [String.htmlSpecialChars(props.regenerateFailure)], 'BackendModule/Configuration', 'NEOSidekick.AiAssistant')}
            </div>
            <div @if={props.signingKey.regenerateIncomplete} style="margin: 0 0 1rem 0; padding: 0.75rem 1rem; border: 1px solid #ff8700; background: #2a2a2a;" data-signing-key-regenerate-incomplete="true">
                <strong>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerateIncomplete.title')}</strong>
                {' '}
                {I18n.translate('signingKey.regenerateIncomplete.body', null, [props.regenerateFailure ? String.htmlSpecialChars(props.regenerateFailure) : I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerateIncomplete.noReason')], 'BackendModule/Configuration', 'NEOSidekick.AiAssistant')}
                {props.regenerateRejectionReason == 'chain_domain_mismatch' ? ' ' : ''}
                {props.regenerateRejectionReason == 'chain_domain_mismatch' ? I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerateIncomplete.chainDomainMismatchHint') : ''}
                {props.signingKey.relabelPending ? ' ' : ''}
                {props.signingKey.relabelPending ? I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerateIncomplete.relabelPending') : ''}
            </div>
            <dl @if={props.signingKey.exists}>
                <dt @if={props.signingKey.fingerprint}><strong>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.fingerprint')}</strong></dt>
                <dd @if={props.signingKey.fingerprint} style="font-family: monospace; word-break: break-all; margin: 0 0 1rem 0;">{String.htmlSpecialChars(props.signingKey.fingerprint)}</dd>
                <dt><strong>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.status')}</strong></dt>
                <dd style="margin: 0 0 1rem 0;">
                    {I18n.translate('signingKey.status.' + props.signingKey.status, String.htmlSpecialChars(props.signingKey.status), [], 'BackendModule/Configuration', 'NEOSidekick.AiAssistant')}
                </dd>
                <dt @if={props.signingKey.pushedAt}><strong>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.lastPush')}</strong></dt>
                <dd @if={props.signingKey.pushedAt} style="font-family: monospace; margin: 0 0 1rem 0;">{String.htmlSpecialChars(props.signingKey.pushedAt)}</dd>
            </dl>
            <p @if={!props.signingKey.exists}>{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.missing')}</p>
            <NEOSidekick.AiAssistant:BackendModule.SigningKeyHostStatus @if={props.signingKey.exists} signingKey={props.signingKey} />
            <form method="POST" action={props.regenerateActionUri} onsubmit="return confirm(this.dataset.confirm)" data-confirm={I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerate.confirm')} style="margin: 0;">
                <input type="hidden" name="__csrfToken" value={props.csrfToken} />
                <label @if={props.signingKey.status == 'unusable' || props.signingKey.status == 'revoked' || props.regenerateRejectionReason == 'chain_domain_mismatch' || (props.signingKey.hostStatusKnown && !props.signingKey.thisHostRegistered)} style="display: block; margin: 0 0 0.75rem 0;">
                    <input type="checkbox" name="moduleArguments[reenrol]" value="1" />
                    {' '}
                    {I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.reenrol.label')}
                </label>
                <button type="submit" class="neos-button neos-button-danger">{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.regenerate.button')}</button>
            </form>
            <form @if={((props.signingKey.hostStatusKnown && !props.signingKey.thisHostRegistered) || props.regenerateRejectionReason == 'chain_domain_mismatch') && props.signingKey.status != 'unusable'} method="POST" action={props.regenerateActionUri} onsubmit="return confirm(this.dataset.confirm)" data-confirm={I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.relabel.confirm')} style="margin: 1rem 0 0 0;" data-signing-key-relabel-form="true">
                <input type="hidden" name="__csrfToken" value={props.csrfToken} />
                <input type="hidden" name="moduleArguments[relabel]" value="1" />
                <button type="submit" class="neos-button neos-button-danger">{I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.relabel.button')}</button>
            </form>
        </div>
    `
}

##
# The host line of the signing-key panel, one sentence from the forced push's answer (see the
# panel's comment): the address, the accepted hosts, this host's standing and the last push
# result. Each part falls back to "unknown" on its own; a rejection reason NEOSidekick coins
# later is shown raw. Below it, the remedy for a host NEOSidekick does not accept yet.
#
prototype(NEOSidekick.AiAssistant:BackendModule.SigningKeyHostStatus) < prototype(Neos.Fusion:Component) {
    signingKey = null

    renderer = Neos.Fusion:Component {
        unknown = ${I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.hosts.unknown')}
        known = ${props.signingKey.hostStatusKnown}
        installAddress = ${this.known && props.signingKey.installAddress ? String.htmlSpecialChars(props.signingKey.installAddress) : this.unknown}
        registeredHosts = ${this.known ? (Array.isEmpty(props.signingKey.registeredHosts) ? I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.hosts.none') : String.htmlSpecialChars(Array.join(props.signingKey.registeredHosts, ', '))) : this.unknown}
        thisHost = ${this.known ? I18n.translate('NEOSidekick.AiAssistant:BackendModule.Configuration:signingKey.hosts.thisHost.' + (props.signingKey.thisHostRegistered ? 'registered' : 'notRegistered')) : this.unknown}
        hostsResult = ${this.known && props.signingKey.hostsResult ? I18n.translate('signingKey.hosts.result.' + props.signingKey.hostsResult, String.htmlSpecialChars(props.signingKey.hostsResult), [], 'BackendModule/Configuration', 'NEOSidekick.AiAssistant') : this.unknown}
        thisHostUnregistered = ${this.known && !props.signingKey.thisHostRegistered}
        thisHostName = ${props.signingKey.thisHost ? String.htmlSpecialChars(props.signingKey.thisHost) : this.unknown}

        renderer = afx`
            <div style="margin: 0 0 1rem 0; padding: 0.75rem 1rem; border: 1px solid #5a5a5a; background: #2a2a2a;" data-signing-key-hosts="true" data-signing-key-host-status={props.known ? (props.thisHostUnregistered ? 'not-registered' : 'registered') : 'unknown'}>
                {I18n.translate('signingKey.hosts.sentence', null, [props.installAddress, props.registeredHosts, props.thisHost, props.hostsResult], 'BackendModule/Configuration', 'NEOSidekick.AiAssistant')}
                {props.thisHostUnregistered ? ' ' : ''}
                {props.thisHostUnregistered ? I18n.translate('signingKey.hosts.notRegistered.remedy', null, [props.thisHostName], 'BackendModule/Configuration', 'NEOSidekick.AiAssistant') : ''}
            </div>
        `
    }
}
