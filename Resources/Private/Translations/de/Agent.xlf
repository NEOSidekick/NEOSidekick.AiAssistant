<?xml version="1.0"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="" source-language="de" datatype="plaintext">
        <body>
            <trans-unit id="pageTitle" xml:space="preserve">
                <source>NEOSidekick Agent Autorisierung</source>
            </trans-unit>
            <trans-unit id="authorizationTitle" xml:space="preserve">
                <source>Erlaube NEOSidekick, mit dir zusammenzuarbeiten</source>
            </trans-unit>
            <trans-unit id="authorizationMessage" xml:space="preserve">
                <source>Erlaube NEOSidekick, auf deinen Arbeitsbereich zuzugreifen sowie Inhalte zu lesen und zu schreiben. Der Chat wird niemals Änderungen live veröffentlichen – du behältst stets die Kontrolle darüber, was veröffentlicht wird.</source>
            </trans-unit>
            <trans-unit id="authorizeButton" xml:space="preserve">
                <source>Autorisieren</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationPageTitle" xml:space="preserve">
                <source>Autorisierung fortsetzen</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationTitle" xml:space="preserve">
                <source>Autorisierung fortsetzen</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationMessage" xml:space="preserve">
                <source>Dein Neos CMS verwendet strenge Sicherheit mit SameSite-Session-Cookies. Aus dem Grund brauchen wir einen Extra-Klick.</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationButton" xml:space="preserve">
                <source>Autorisierung fortsetzen</source>
            </trans-unit>
            <trans-unit id="externalAuthorizationTitle" xml:space="preserve">
                <source>Externe Anwendung verbinden</source>
            </trans-unit>
            <trans-unit id="externalClientUnnamed" xml:space="preserve">
                <source>Unbenannte Anwendung</source>
            </trans-unit>
            <trans-unit id="externalClientMessage" xml:space="preserve">
                <source>Eine Anwendung, die sich "{0}" nennt (nicht von NEOSidekick überprüft), fordert Zugriff auf diese Neos-Installation an.</source>
            </trans-unit>
            <trans-unit id="externalIdentityMessage" xml:space="preserve">
                <source>Wenn du zustimmst, kann die Anwendung Inhalte mit deinen eigenen Redaktionsrechten lesen und schreiben, als {0}. Sie wird niemals etwas live veröffentlichen.</source>
            </trans-unit>
            <trans-unit id="externalRedirectMessage" xml:space="preserve">
                <source>Die Anwendung gibt an, dich anschließend zu {0} zurückzuleiten.</source>
            </trans-unit>
            <trans-unit id="externalAuthorizeButton" xml:space="preserve">
                <source>Zugriff erlauben</source>
            </trans-unit>
            <trans-unit id="externalDeclineLink" xml:space="preserve">
                <source>Abbrechen und Zugriff verweigern</source>
            </trans-unit>
        </body>
    </file>
