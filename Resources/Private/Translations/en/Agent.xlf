<?xml version="1.0"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="" source-language="en" datatype="plaintext">
        <body>
            <trans-unit id="pageTitle" xml:space="preserve">
                <source>NEOSidekick Agent Authorization</source>
            </trans-unit>
            <trans-unit id="authorizationTitle" xml:space="preserve">
                <source>Allow NEOSidekick to work together with you</source>
            </trans-unit>
            <trans-unit id="authorizationMessage" xml:space="preserve">
                <source>Allow NEOSidekick to access your workspace, read and write content. The chat will never publish any changes to live, you are always in control of what is published.</source>
            </trans-unit>
            <trans-unit id="authorizeButton" xml:space="preserve">
                <source>Authorize</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationPageTitle" xml:space="preserve">
                <source>Continue authorization</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationTitle" xml:space="preserve">
                <source>Continue authorization</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationMessage" xml:space="preserve">
                <source>Your Neos CMS uses strict security with SameSite session cookies. For this reason we need an extra-approval click.</source>
            </trans-unit>
            <trans-unit id="continueAuthorizationButton" xml:space="preserve">
                <source>Continue authorization</source>
            </trans-unit>
            <trans-unit id="externalAuthorizationTitle" xml:space="preserve">
                <source>Connect an external application</source>
            </trans-unit>
            <trans-unit id="externalClientUnnamed" xml:space="preserve">
                <source>Unnamed client</source>
            </trans-unit>
            <trans-unit id="externalClientMessage" xml:space="preserve">
                <source>An application calling itself "{0}" (not verified by NEOSidekick) is asking for access to this Neos installation.</source>
            </trans-unit>
            <trans-unit id="externalIdentityMessage" xml:space="preserve">
                <source>If you allow it, the application can read and write content with your own editor permissions, as {0}. It will never publish anything to live.</source>
            </trans-unit>
            <trans-unit id="externalRedirectMessage" xml:space="preserve">
                <source>The application says it will send you back to {0} afterwards.</source>
            </trans-unit>
            <trans-unit id="externalAuthorizeButton" xml:space="preserve">
                <source>Allow access</source>
            </trans-unit>
            <trans-unit id="externalDeclineLink" xml:space="preserve">
                <source>Cancel and deny access</source>
            </trans-unit>
        </body>
    </file>
</xliff>
